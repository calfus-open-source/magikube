exports[`Azure Template Rendering (integration) Azure environment templates provider.tf.liquid renders 1`] = `
"terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 2.53.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    cloudinit = {
      source  = "hashicorp/cloudinit"
      version = "2.3.5"
    }
  }
}

provider "azurerm" {
  features {}
  resource_provider_registrations = "none"
  subscription_id                 = var.subscription_id
}
"
`;

exports[`Azure Template Rendering (integration) Azure environment templates terraform.tfvars.liquid renders 1`] = `
"####################### Common Variables #######################
subscription_id            = ""
project_name               = "testproj"
environment                = "dev"
location                   = "eastus"
domain_name                = ""
resource_group_name        = "testproj-rg"
common_resource_group_name = "testproj-rg"
# Disable availability zones for West US compatibility
availability_zones         = []
tags = {
  Environment = "dev"
  Project     = "testproj"
}

####################### SQL Server Variables #######################
sql_admin_username = "sqladmin"
sql_admin_password = "P@ssw0rd123!"  # Consider injecting this securely
database_name      = "app_database"
sql_firewall_rules = [
  {
    name             = "AllowBastion"
    start_ip_address = "10.0.0.0"
    end_ip_address   = "10.0.0.255"
  }
]

####################### VNet Variables #######################
vnet_address_space        = ["10.0.0.0/16"]
# Subnet configuration - making it dynamic and configurable
subnet_prefix_length      = 8
private_subnet_offset     = 20
public_subnet_offset      = 0
app_gateway_subnet_offset = 40
k8s_private_subnet_offset = 30
frontend_subnet_offset    = 50

####################### security_group variables #######################
source_bastion_ip = [ "27.107.44.50/32", "58.84.60.45/32", "58.84.62.238/32" ]

####################### VPN Gateway Configuration #######################
# enable_vpn_gateway = true
# gateway_subnet_address_prefix = "10.0.60.0/24"
# vpn_client_address_space = ["10.1.0.0/24"]

####################### AI Foundry Variables #######################
# enable_ai_foundry = true
# openai_location = "Eest US"
# gpt4o_capacity = 50
# o3_mini_capacity = 20  
# embedding_capacity = 50

####################### Version Control Variables #######################

github_access_token = "ghp_test_token_placeholder"
github_owner = "test-org"
appType = ["react", "node-express", "keycloak-service", "auth-service", "gen-ai-service"]

####################### ACR Variables #######################

acr_repo_names = ["myreact", "mynodeexpress", "mykeycloakservice", "myauthservice", "mygenaiservice"]
"
`;

exports[`Azure Template Rendering (integration) Azure environment templates variables.tf.liquid renders 1`] = `
"####################### common variables #######################

variable "subscription_id" {
  description = "The Azure subscription ID"
  type        = string
}

variable "project_name" {
  description = "The project name"
  type        = string
}

variable "environment" {
  description = "The environment (e.g., dev, qa, prod)"
  type        = string
}

variable "location" {
  description = "The Azure location/region"
  type        = string
}

variable "resource_group_name" {
  description = "The name of the resource group"
  type        = string
}

variable "tags" {
  description = "Tags to apply to all resources"
  type        = map(string)
}

variable "availability_zones" {
  description = "List of availability zones to deploy resources into."
  type        = list(string)
  default     = ["1", "2", "3"]
}

variable "domain_name" {
  description = "Domain Name."
  type        = string
}

variable "common_resource_group_name" {
  description = "The name of the common resource group where acr repos are created"
  type        = string
}

variable "acr_repo_names" {
  description = "List of ACR registry names to create"
  type        = list(string)
  default     = []
}

####################### sql server variables #######################

variable "sql_location" {
  description = "The Azure location/region for SQL Server (can be different from main location)"
  type        = string
  default     = ""
}

variable "sql_admin_username" {
  description = "The administrator username for the SQL Server"
  type        = string
  default     = "sqladmin"
}

variable "sql_admin_password" {
  description = "The administrator password for the SQL Server"
  type        = string
  sensitive   = true
}

variable "database_name" {
  description = "The name of the database to create"
  type        = string
  default     = "app_database"
}

variable "sql_firewall_rules" {
  description = "List of firewall rules for SQL Server"
  type = list(object({
    name             = string
    start_ip_address = string
    end_ip_address   = string
  }))
  default = []
}

####################### vpn gateway variables #######################

# variable "enable_vpn_gateway" {
#   description = "Whether to enable VPN Gateway"
#   type        = bool
#   default     = true
# }

# variable "gateway_subnet_address_prefix" {
#   description = "The address prefix for the Gateway subnet"
#   type        = string
#   default     = "10.0.60.0/24"
# }

 variable "vpn_client_address_space" {
   description = "The address space for VPN clients"
   type        = list(string)
   default     = ["10.1.0.0/24"]
  }

####################### vnet variables #######################

variable "vnet_address_space" {
  description = "The address space for the VNet"
  type        = list(string)
  default     = ["10.0.0.0/16"]
}

variable "subnet_prefix_length" {
  description = "The prefix length for subnets"
  type        = number
  default     = 8
}

variable "private_subnet_offset" {
  description = "Offset for private subnets in the address space"
  type        = number
  default     = 20
}

variable "public_subnet_offset" {
  description = "Offset for public subnets in the address space"
  type        = number
  default     = 0
}

variable "app_gateway_subnet_offset" {
  description = "Offset for the Application Gateway subnet index to ensure no overlap."
  type        = number
  default     = 40
}

variable "k8s_private_subnet_offset" {
  description = "Offset for the k8s subnet index to ensure no overlap."
  type        = number
  default     = 30
}

variable "frontend_subnet_offset" {
  description = "Offset for the frontend subnet index to ensure no overlap."
  type        = number
  default     = 50
}

variable "public_ip_allocation_method" {
  description = "The allocation method for public IPs"
  type        = string
  default     = "Static"
}

variable "public_ip_sku" {
  description = "The SKU for public IPs"
  type        = string
  default     = "Standard"
}

####################### bastion variables #######################

variable "bastion_admin_username" {
  description = "The admin username for the bastion host VM."
  type        = string
  default     = "ubuntu"
}

variable "bastion_vm_size" {
  description = "The size of the virtual machine."
  type        = string
  default     = "Standard_B2ms"
}

variable "bastion_os_disk_size" {
  description = "The size of the OS disk in GB."
  type        = number
  default     = 30
}

variable "image_publisher" {
  description = "The publisher of the image."
  type        = string
  default     = "Canonical"
}

variable "image_offer" {
  description = "The offer of the image."
  type        = string
  default     = "0001-com-ubuntu-server-jammy"
}

variable "image_sku" {
  description = "The SKU of the image."
  type        = string
  default     = "22_04-lts-gen2"
}

variable "image_version" {
  description = "The version of the image."
  type        = string
  default     = "latest"
}

variable "bastion_public_ip_allocation_method" {
  type    = string
  default = "Static"
}

variable "bastion_public_ip_sku" {
  type    = string
  default = "Standard"
}

variable "bastion_private_ip_address_allocation" {
  type    = string
  default = "Dynamic"
}

variable "bastion_os_disk_caching" {
  type    = string
  default = "ReadWrite"
}

variable "bastion_os_disk_storage_account_type" {
  type    = string
  default = "Standard_LRS"
}

####################### security_group variables #######################

variable "source_bastion_ip" {
  type    = list(string)
  default = []
}

####################### ai foundry variables #######################

# variable "enable_ai_foundry" {
#   description = "Whether to enable Azure AI Foundry"
#   type        = bool
#   default     = false
# }

# variable "openai_location" {
#   description = "The Azure location for OpenAI service (limited regions)"
#   type        = string
#   default     = "East US"
# }

