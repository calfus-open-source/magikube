  description = "The ID of the NSG for the frontend private subnet"
  type        = string
}

variable "vnet_address_space" {
  description = "The address space for the VNet"
  type        = list(string)
}

variable "subnet_prefix_length" {
  description = "The prefix length for subnets"
  type        = number
}

variable "k8s_private_subnet_offset" {
  description = "Offset for the Kubernetes private subnet"
  type        = number
}

variable "frontend_subnet_offset" {
  description = "Offset for the frontend subnet"
  type        = number
}

# Azure AD authentication variables (for VPN Gateway configuration)
variable "aad_tenant" {
  description = "The Azure AD tenant URL for VPN authentication"
  type        = string
  default     = "https://login.microsoftonline.com/c9e9daed-146b-4959-923c-fcdff492c507/"
}

variable "aad_audience" {
  description = "The Azure AD application audience for VPN authentication"
  type        = string
  default     = "41b23e61-6c1e-4545-b367-cd054e0ed4b4"
}

variable "aad_issuer" {
  description = "The Azure AD issuer URL for VPN authentication"
  type        = string
  default     = "https://sts.windows.net/c9e9daed-146b-4959-923c-fcdff492c507/"
}
"
