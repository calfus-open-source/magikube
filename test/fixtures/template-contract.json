{
  "_meta": {
    "description": "Template contract manifest. Lists all Liquid variables that magikube must provide when rendering templates from infrastructure-templates repo. Generated by scanning {{ var }} and {% if var %} in .liquid files.",
    "last_updated": "2026-03-16",
    "source_repo": "calfus-open-source/infrastructure-templates"
  },
  "aws": {
    "description": "Variables required by AWS templates (eks-fargate, eks-nodegroup, k8s, modules, policies, ansible, predefined)",
    "required_variables": [
      "project_name",
      "environment",
      "aws_region",
      "aws_access_key_id",
      "aws_secret_access_key",
      "aws_profile",
      "aws_vpc_cidr",
      "aws_az_count",
      "aws_eks_cluster_version",
      "aws_eks_module_version",
      "aws_vpc_module_version",
      "aws_load_balancer_controller_version",
      "source_code_repository",
      "github_owner",
      "github_access_token",
      "git_user_name",
      "frontend_app_type",
      "backend_app_type"
    ],
    "conditional_variables": {
      "cluster_type:k8s": [
        "bastion_instance_type",
        "bastion_instance_count",
        "bastion_host_ami_owner",
        "bastion_host_ami_name",
        "bastion_host_ami_virtualization_type",
        "master_instance_type",
        "master_instance_count",
        "master_host_ami_owner",
        "master_host_ami_name",
        "master_host_ami_virtualization_type",
        "worker_instance_type",
        "worker_instance_count",
        "worker_host_ami_owner",
        "worker_host_ami_name",
        "worker_host_ami_virtualization_type",
        "kube_version",
        "kube_cni_version",
        "service_cidr",
        "pod_network_cidr",
        "disk_size",
        "ebs_vol_size",
        "kube_reserved_cpu",
        "kube_reserved_memory",
        "system_reserved_cpu",
        "system_reserved_memory",
        "eviction_memory_threshold"
      ],
      "cluster_type:eks-fargate": [
        "kube_version",
        "service_cidr",
        "pod_network_cidr"
      ],
      "cluster_type:eks-nodegroup": [
        "node_instance_type",
        "node_desired_size",
        "node_max_size",
        "node_min_size",
        "ebs_volume_size",
        "ebs_volume_type",
        "kube_version",
        "service_cidr",
        "pod_network_cidr"
      ]
    }
  },
  "azure": {
    "description": "Variables required by Azure templates (environments, modules)",
    "required_variables": [
      "project_name",
      "environment",
      "azure_location",
      "resource_group_name",
      "source_code_repository",
      "github_owner",
      "github_access_token",
      "frontend_app_type",
      "backend_app_type"
    ],
    "conditional_variables": {
      "feature:sql_server": [
        "database_name",
        "sql_admin_username"
      ],
      "feature:vpn_gateway": [
        "vpn_client_address_space",
        "gateway_subnet_address_prefix"
      ],
      "feature:ai_foundry": [
        "openai_location",
        "gpt4o_capacity",
        "o3_mini_capacity",
        "embedding_capacity"
      ]
    }
  },
  "common": {
    "description": "Variables required by common-modules (argocd, gitops, code-repository, providers)",
    "required_variables": [
      "terraform_version",
      "github_provider_version",
      "argocd_helm_version",
      "aws_az_count"
    ]
  }
}
